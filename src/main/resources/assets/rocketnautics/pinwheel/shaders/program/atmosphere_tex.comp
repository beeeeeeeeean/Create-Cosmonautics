#version 430

#include rocketnautics:common_math

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(r32f, binding = 0) uniform image2D result;

uniform int shape;

uniform float fAtmosphere;
uniform float falloff;

uniform int texSz;
uniform int samples;

float opticalDepth(vec2 rO, vec2 rD, float rL) {
    if (rL <= 0.0) return 0.0;

    float stepSz = rL / float(samples);
    float tau = 0.0;

    for (int i = 0; i < samples; i++) {
        float t = (float(i) + 0.5) * stepSz;
        float localDensity = densityAtP(shape, vec3(rO + rD * t, 0.0), fAtmosphere, 1.0, falloff, 0, mat4(1.0));

        tau += localDensity * stepSz;
    }

    return tau;
}

void main() {
    vec2 uv = vec2(gl_GlobalInvocationID.xy) / float(texSz - 1);

    float mu = 1.0 - 2.0 * uv.x;
    vec2 dir = vec2(sin(acos(mu)), mu);

    // atmosphere is normalized so that planet radius is always 1. Atmosphere factor must be proportional to the actual planet (rAtmosphere/rPlanet)
    vec2 p = vec2(0, mix(1, fAtmosphere, uv.y));
    float dtAtmo = rayShape(shape, fAtmosphere, mat4(1.0), vec3(p, 0), vec3(dir, 0)).y;

    float scattering = opticalDepth(p + dir * 0.0001, dir, dtAtmo-0.0002);
    imageStore(result, ivec2(gl_GlobalInvocationID.xy), vec4(scattering));
}